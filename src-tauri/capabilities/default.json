{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local companion window",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging",
    "global-shortcut:allow-register", "global-shortcut:allow-unregister", "global-shortcut:allow-is-registered",
    "autostart:default", "notification:default", "opener:allow-open-url"
  ]
}
