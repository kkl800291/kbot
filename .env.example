# 复制为 .env.release.local 后填入你自己的服务器 SSH 配置（.env.release.local 已被 Git 忽略，不会上传到仓库）
KBOT_DEPLOY_SSH="ubuntu@your-server-ip"
KBOT_DEPLOY_SSH_KEY="~/.ssh/your_deploy_key"
KBOT_DEPLOY_DIR="/home/ubuntu/starnet/site/kbot/releases"
KBOT_RELEASE_BASE_URL="https://schathub.xyz/kbot/releases"
KBOT_KEEP_REMOTE_VERSIONS="3"
