{
  "name": "cyber-companion",
  "version": "0.2.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kkl800291/kbot.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/desktop.mjs",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "release": "node scripts/release-deploy.mjs",
    "release:manifest": "node scripts/generate-update-manifest.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^4.0.0"
  }
}
